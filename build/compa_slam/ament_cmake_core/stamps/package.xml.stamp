<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>compa_slam</name>
  <version>0.0.0</version>
  <description>
    Visual SLAM + off-road perception pipeline for COMPA: RealSense D455 RGBD ->
    RTAB-Map (mapping/localization) -> elevation map -> existing off-road planners.
    Self-contained: adds only new files, leaves the rest of the workspace untouched.
  </description>
  <maintainer email="thekaiyu@gmail.com">kai</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Python launch infrastructure used directly by every installed launch file. -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch_xml</exec_depend>

  <!-- Simulation + robot bring-up (Phase 0) -->
  <depend>robot_state_publisher</depend>
  <depend>ros_gz_sim</depend>
  <depend>ros_gz_bridge</depend>
  <depend>xacro</depend>
  <depend>rviz2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>hamr_interfaces</exec_depend>
  <exec_depend>reference_trajectory</exec_depend>

  <!-- Reuse the existing COMPA robot description (meshes/links) -->
  <exec_depend>compa_description</exec_depend>

  <!-- Visual SLAM stack (Phase 0/1) -->
  <exec_depend>rtabmap_slam</exec_depend>
  <exec_depend>rtabmap_odom</exec_depend>
  <exec_depend>rtabmap_sync</exec_depend>
  <exec_depend>rtabmap_viz</exec_depend>
  <exec_depend>rtabmap_launch</exec_depend>

  <!-- Real RealSense D455 + IMU fusion (Phase 1, hardware only) -->
  <exec_depend>realsense2_camera</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>

  <!-- Hardware trajectory recording: record_trajectory.launch.py reuses the calibrated
       onboard localization stack by including hamr_bringup/hamr_HW.launch.xml -->
  <exec_depend>hamr_bringup</exec_depend>
  <exec_depend>hamr_teleop</exec_depend>
  <exec_depend>robot_localization</exec_depend>

  <!-- Recording / replay -->
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>

  <!-- Sim-setup pipeline: scripts/map_to_sim.py (recorded map -> Gazebo heightmap world).
       NumPy + Pillow only, no ROS deps, so it can run wherever the cloud was captured.
       /elevation_map + /costmap in the replay come from hamr_control_cpp's
       cost_map_publisher, so that package is a runtime dep of replay_map_sim.launch.py. -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>hamr_control_cpp</exec_depend>

  <!--
    NOTE: elevation mapping is added in Phase 2. Robot is CPU-only, so we use the
    C++ `elevation_mapping` package (NOT elevation_mapping_cupy, which requires an
    NVIDIA GPU). Install it separately when we reach that phase.
  -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
