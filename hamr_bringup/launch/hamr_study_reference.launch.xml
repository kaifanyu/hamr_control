<launch>
    <!-- The hardware/controller stack is intentionally separate. This launch
         owns exactly one study reference and its matching recorder. -->
    <arg name="bag_name" />
    <arg name="run_id" />
    <arg name="planned_id" default="" />
    <arg name="profile" />
    <arg name="profile_sha256" />
    <arg name="speed_m_s" />
    <arg name="controller_config_sha256" />
    <arg name="wheel_speed_limit_rad_s" />
    <arg name="turret_control_enabled" />
    <arg name="nominal_start_base_yaw_rad" default="0.0" />
    <arg name="start_base_yaw_tolerance_rad" default="0.15" />
    <arg name="study_stack_contract_version" default="1" />
    <arg name="controller_odom_timeout_s" default="0.0" />
    <arg name="vicon_pose_guard_enabled" default="false" />
    <arg name="reference_timeout_s" default="0.12" />
    <arg name="xy_velocity_source" default="odom_twist_world" />
    <arg name="caster_type" default="unspecified" />
    <arg name="terrain" default="flat" />
    <arg name="initial_caster_orientation_deg" default="0" />
    <arg name="repetition" default="1" />
    <arg name="video_id" default="" />
    <arg name="notes" default="" />

    <!-- Start recording before the publisher. The trajectory's subscriber
         gate waits for both this recorder and the already-running controller. -->
    <node pkg="hamr_bringup" exec="record_hamr_test_bag"
          args="$(var bag_name)" output="screen" />

    <node pkg="reference_trajectory" exec="study_trajectory"
          name="hamr_study_trajectory" output="screen">
        <param name="run_id" value="$(var run_id)" type="str" />
        <param name="planned_id" value="$(var planned_id)" type="str" />
        <param name="profile" value="$(var profile)" type="str" />
        <param name="preflight_profile_sha256"
               value="$(var profile_sha256)" type="str" />
        <param name="speed_m_s" value="$(var speed_m_s)" type="float" />
        <param name="controller_config_sha256"
               value="$(var controller_config_sha256)" type="str" />
        <param name="wheel_speed_limit_rad_s"
               value="$(var wheel_speed_limit_rad_s)" type="float" />
        <param name="turret_control_enabled"
               value="$(var turret_control_enabled)" type="bool" />
        <param name="nominal_start_base_yaw_rad"
               value="$(var nominal_start_base_yaw_rad)" type="float" />
        <param name="start_base_yaw_tolerance_rad"
               value="$(var start_base_yaw_tolerance_rad)" type="float" />
        <param name="study_stack_contract_version"
               value="$(var study_stack_contract_version)" type="int" />
        <param name="controller_odom_timeout_s"
               value="$(var controller_odom_timeout_s)" type="float" />
        <param name="vicon_pose_guard_enabled"
               value="$(var vicon_pose_guard_enabled)" type="bool" />
        <param name="reference_timeout_s"
               value="$(var reference_timeout_s)" type="float" />
        <param name="xy_velocity_source"
               value="$(var xy_velocity_source)" type="str" />
        <param name="caster_type" value="$(var caster_type)" type="str" />
        <param name="terrain" value="$(var terrain)" type="str" />
        <param name="initial_caster_orientation_deg"
               value="$(var initial_caster_orientation_deg)" type="float" />
        <param name="repetition" value="$(var repetition)" type="int" />
        <param name="video_id" value="$(var video_id)" type="str" />
        <param name="notes" value="$(var notes)" type="str" />
        <param name="reference_timer_hz" value="50.0" type="float" />
        <param name="startup_hold_s" value="2.0" type="float" />
        <param name="final_hold_s" value="3.0" type="float" />
        <param name="loop" value="false" type="bool" />
        <param name="required_reference_subscribers" value="2" type="int" />
        <param name="subscriber_stable_s" value="1.0" type="float" />
    </node>
</launch>
