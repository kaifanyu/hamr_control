<launch>
  <!-- Preserve existing installed ball configurations and command behavior. -->
  <arg name="config_file" default="$(find-pkg-share hamr_bringup)/config/caster_encoders.yaml" />
  <arg name="record_bag" default="true" />
  <include file="$(find-pkg-share hamr_bringup)/launch/caster_encoders.launch.xml">
    <arg name="config_file" value="$(var config_file)" />
    <arg name="record_bag" value="$(var record_bag)" />
  </include>
</launch>
