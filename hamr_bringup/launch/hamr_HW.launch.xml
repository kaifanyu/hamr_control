<launch>
    <!-- Path Variables -->
    <let name="urdf_path" 
        value="$(find-pkg-share hamr_description)/urdf/hamr.urdf.xacro" />
    <let name="rviz_config_path" 
        value="$(find-pkg-share hamr_description)/rviz/HW_urdf_config.rviz" />
    <let name="pid_config_path"
        value="$(find-pkg-share hamr_bringup)/config/hamr_hw_control_params.yaml" />
    <arg name="record_bag" default="true" />
    <arg name="record_video" default="true" />

    
    <!-- To launch the URDF Robot State Publisher -->
    <!-- <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" 
            value="$(command 'xacro $(var urdf_path)')" />
    </node>  -->

    <!-- Launch Rviz with the configuration -->
    <!-- <node pkg="rviz2" exec="rviz2" output="screen"
          args="-d $(var rviz_config_path)" /> -->

    <!-- Launch HAMR Controller -->
    <node pkg="hamr_control" exec="hamr_controller" on_exit="shutdown" >
        <param from="$(var pid_config_path)" />
    </node>

    <!-- One run folder contains video, per-frame timestamps and localization bag.
         recording.launch.py also exposes camera_device, recording_root, etc. -->
    <include file="$(find-pkg-share hamr_bringup)/launch/recording.launch.py">
        <arg name="record_bag" value="$(var record_bag)" />
        <arg name="record_video" value="$(var record_video)" />
        <arg name="use_sim_time" value="false" />
    </include>

    <!-- Graphing -->
    <!-- <node pkg="hamr_control" exec="hamr_pid_graph" />
    <node pkg="hamr_control" exec="hamr_odom_graph"/>
    <node pkg="hamr_control_cpp" exec="hamr_path_tracer" /> -->

    <node pkg="hamr_uros_bridge" exec="relay_node" on_exit="shutdown" />

    <!-- Foxglove bridge — connect Studio to ws://PI_IP:8765 -->
    <node pkg="foxglove_bridge" exec="foxglove_bridge" output="screen">
        <param name="port" value="8765" />
        <param name="address" value="0.0.0.0" />
        <param name="send_buffer_limit" value="10000000" />
    </node>

</launch>
