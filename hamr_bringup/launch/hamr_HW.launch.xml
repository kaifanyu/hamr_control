<launch>
    <!-- Path Variables -->
    <let name="urdf_path"
        value="$(find-pkg-share hamr_description)/urdf/hamr.urdf.xacro" />
    <let name="rviz_config_path"
        value="$(find-pkg-share hamr_description)/rviz/HW_urdf_config.rviz" />
    <let name="pid_config_path"
        value="$(find-pkg-share hamr_bringup)/config/hamr_hw_control_params.yaml" />
    <let name="ekf_config_path"
        value="$(find-pkg-share hamr_bringup)/config/ekf.yaml" />
    <let name="ekf_mag_config_path"
        value="$(find-pkg-share hamr_bringup)/config/ekf_mag.yaml" />
    <let name="ekf_orientation_config_path"
        value="$(find-pkg-share hamr_bringup)/config/ekf_orientation.yaml" />
    <let name="bridge_config_path"
        value="$(find-pkg-share hamr_bringup)/config/hamr_uros_bridge.yaml" />
    <arg name="record_bag" default="true" />
    <arg name="record_camera" default="true" description="Record both caster cameras throughout the hardware session." />
    <arg name="camera_repository" default="$(env HOME)/Caster_Vision/ball_caster_dual_cam" />
    <arg name="camera_config" default="$(var camera_repository)/config/rig.yaml"
         description="Use the same rig YAML for recording and caster calibration." />
    <arg name="recording_root" default="$(env HOME)/hamster_ws/recordings" description="Camera clip directory; robot bags still use HAMR_BAG_ROOT." />
    <arg name="camera_segment_mib" default="1024" />
    <arg name="run_controller" default="true" />
    <!-- Bound how long a cached trajectory command can survive a publisher
         abort. Supervised hardware tests require this exact 120 ms value. -->
    <arg name="controller_reference_timeout_s" default="0.12" />
    <!-- Opt-in only: exact mirrored diagnostics use 0.45 s at 0.15 m/s or
         0.20 s at 0.20 m/s to bridge measured short Vicon receipt gaps.
         Normal hardware remains at the 0.12 s fail-stop default. -->
    <arg name="controller_odom_timeout_s" default="0.12" />
    <!-- Normal hardware closes the loop on raw Vicon odometry.  These
         default-preserving overrides also let the dedicated waypoint/local
         wrapper select onboard odometry without duplicating this launch. -->
    <arg name="controller_odom_topic" default="/HAMR_base/odom" />
    <arg name="controller_xy_velocity_source" default="odom_twist_world" />
    <arg name="controller_vicon_pose_guard_enabled" default="true" />
    <arg name="controller_vicon_min_z_m" default="0.25" />
    <arg name="controller_vicon_max_z_m" default="0.40" />
    <!-- Vicon is stamped on an unsynchronized remote host. Freshness is based
         on local receipt time while source stamps remain valid and monotonic. -->
    <arg name="controller_vicon_source_stamp_policy"
         default="receipt_monotonic" />
    <arg name="run_foxglove" default="true" />
    <arg name="use_mag" default="true" />
    <arg name="use_orientation" default="false" />

    
    <!-- To launch the URDF Robot State Publisher -->
    <!-- <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" 
            value="$(command 'xacro $(var urdf_path)')" />
    </node>  -->

    <!-- Launch Rviz with the configuration -->
    <!-- <node pkg="rviz2" exec="rviz2" output="screen"
          args="-d $(var rviz_config_path)" /> -->

    <!-- Launch HAMR Controller -->
    <node pkg="hamr_control" exec="hamr_controller" if="$(var run_controller)">
        <param from="$(var pid_config_path)" />
        <param name="reference_timeout_s" value="$(var controller_reference_timeout_s)" />
        <param name="odom_timeout_s" value="$(var controller_odom_timeout_s)" />
        <param name="xy_velocity_source" value="$(var controller_xy_velocity_source)" />
        <param name="vicon_pose_guard_enabled" value="$(var controller_vicon_pose_guard_enabled)" />
        <param name="vicon_min_z_m" value="$(var controller_vicon_min_z_m)" />
        <param name="vicon_max_z_m" value="$(var controller_vicon_max_z_m)" />
        <param name="vicon_source_stamp_policy" value="$(var controller_vicon_source_stamp_policy)" />
        <remap from="HAMR_base/odom" to="$(var controller_odom_topic)" />
    </node>

    <!-- Graphing -->
    <!-- <node pkg="hamr_control" exec="hamr_pid_graph" />
    <node pkg="hamr_control" exec="hamr_odom_graph"/>
    <node pkg="hamr_control_cpp" exec="hamr_path_tracer" /> -->

    <!-- Wheel odometry: integrates encoder ticks → /wheel_odom
         publish_tf is false because the EKF below owns the odom→base_link TF -->
    <node pkg="hamr_odometry" exec="holonomic_odom_node" output="screen">
        <param name="publish_tf" value="false"/>
        <param name="r_wheel" value="0.1250"/>
        <param name="a_wheel" value="0.350"/>
        <param name="b_wheel" value="0.45"/>
        <param name="base_yaw_offset" value="1.57079632679"/>
        <param name="yaw_sign" value="1.0"/>
        <!-- Post-filter five-revolution calibration, 2026-08-18:
             left=2260.4 ticks/rev, right=2263.6 ticks/rev. -->
        <param name="left_tick_scale" value="1.001460"/>
        <param name="right_tick_scale" value="1.000044"/>
        <param name="ticks_per_rev" value="2263.7"/>
    </node>

    <!-- IMU mounting TF: BNO055 is mounted flat and axis-aligned with base_link
         (X forward, Z up), so imu_link → base_link is identity. The EKF needs this
         transform to rotate /imu/data into base_link; without it every IMU message
         is rejected. Replace the offsets here if the IMU is ever remounted. -->
    <node pkg="tf2_ros" exec="static_transform_publisher" name="imu_link_static_tf"
          args="--x 0.0 --y 0.0 --z 0.0 --roll 0.0 --pitch 0.0 --yaw 0.0 --frame-id base_link --child-frame-id imu_link" />

    <!-- EKF: fuses /wheel_odom + /imu/data into /local_HAMR/odom and owns odom→base_link TF.
         use_orientation:=true             -> ekf_orientation.yaml  (BNO055 quaternion yaw, relative; no raw gz)
         use_orientation:=false use_mag:=false -> ekf.yaml          (raw gyro yaw-rate only)
         use_orientation:=false use_mag:=true  -> ekf_mag.yaml      (BNO055 absolute-yaw / magnetometer) -->
    <group unless="$(var use_orientation)">
        <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node" output="screen"
              unless="$(var use_mag)">
            <param from="$(var ekf_config_path)"/>
            <remap from="odometry/filtered" to="local_HAMR/odom"/>
        </node>
        <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node" output="screen"
              if="$(var use_mag)">
            <param from="$(var ekf_mag_config_path)"/>
            <remap from="odometry/filtered" to="local_HAMR/odom"/>
        </node>
    </group>
    <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node" output="screen"
          if="$(var use_orientation)">
        <param from="$(var ekf_orientation_config_path)"/>
        <remap from="odometry/filtered" to="local_HAMR/odom"/>
    </node>

    <!-- uROS bridge — serial_port/baud configured in hamr_uros_bridge.yaml
         ESP USB-CDC (logs) is /dev/ttyACM0 @ 115200.
         Serial0 data UART is typically /dev/ttyUSB0 @ 460800 — verify with: ls /dev/ttyUSB* -->
    <node pkg="hamr_uros_bridge" exec="relay_node">
        <param from="$(var bridge_config_path)" />
    </node>

    <!-- Waypoint trajectory publisher — loops the hardcoded path in waypoint_traj_simple.py -->
    <!-- <node pkg="reference_trajectory" exec="waypoint_traj_simple" output="screen" /> -->

    <!-- Record Vicon, onboard localization, commands, and encoder ticks for offline comparison. -->
    <node pkg="hamr_bringup" exec="record_hamr_test_bag"
          output="screen" if="$(var record_bag)" />

    <!-- Both cameras use the calibration rig profiles and save until launch shutdown.
         Start the separate waypoint_traj_simple command after 'Recording NOW'. -->
    <include file="$(find-pkg-share hamr_bringup)/launch/camera_recording.launch.xml"
             if="$(var record_camera)">
        <arg name="camera_repository" value="$(var camera_repository)" />
        <arg name="camera_config" value="$(var camera_config)" />
        <arg name="recording_root" value="$(var recording_root)" />
        <arg name="camera_segment_mib" value="$(var camera_segment_mib)" />
    </include>

    <!-- Foxglove WebSocket bridge — connect Foxglove Studio to ws://<robot-ip>:8765 -->
    <node pkg="foxglove_bridge" exec="foxglove_bridge" name="foxglove_bridge"
          if="$(var run_foxglove)">
        <param name="port" value="8765" />
    </node>

</launch>
