#!/usr/bin/env python3
"""Supervised, one-shot closed-loop left/right turn validation for HAMR.

The node publishes only ``/reference_trajectory``; ``hamr_controller`` remains
the sole wheel-command publisher. Compact routes are transformed relative to
the first stable Vicon pose; the Vicon corridor and legacy routes translate to
that pose while retaining fixed Vicon-axis directions. Motion is opt-in,
bounded, monitored, and followed by a deliberate reference timeout whose zero
wheel commands are verified before this exits.
"""

from collections import deque
import math
import time

from hamr_control.hamr_controller import (
    VICON_SOURCE_STAMP_POLICY,
    source_timestamp_is_valid_and_monotonic,
    validated_vicon_source_stamp_policy,
)
from hamr_interfaces.msg import ReferenceTraj
from nav_msgs.msg import Odometry
import rclpy
from rclpy.executors import SingleThreadedExecutor
from rclpy.node import Node
from rclpy.parameter import parameter_value_to_python
from rclpy.parameter_client import AsyncParameterClient
from rclpy.qos import HistoryPolicy, QoSProfile, ReliabilityPolicy
from std_msgs.msg import Float64, Float64MultiArray


# For the compact profile, local +Y is forward when HAMR's configured
# base_yaw_offset is pi/2.  Those offsets are rotated by the captured raw Vicon
# yaw. The legacy profile translates with the start but deliberately retains
# fixed Vicon-axis directions rather than rotating with HAMR's heading.
S_CURVE_PATH_OFFSETS = (
    (0.000, 0.00),
    (-0.025, 0.10),
    (-0.070, 0.20),
    (-0.070, 0.30),
    (0.000, 0.40),
    (0.070, 0.50),
    (0.070, 0.60),
    (0.025, 0.70),
    (0.000, 0.80),
)

# Fixed-axis corridor used to isolate powered Vicon tracking from turns.
VICON_STRAIGHT_PATH_OFFSETS = (
    (0.0, 0.0),
    (0.0, 0.8),
)

# Short, fixed-axis serpentine for comparing sharp left and right turns in one
# uninterrupted run.  Its direction sequence is N,W,N,E,N, giving mirrored
# L,R,R,L corners without any intermediate hold or state-dependent gate.
MIRRORED_90_PATH_OFFSETS = (
    (0.0, 0.0),
    (0.0, 1.0),
    (-1.0, 1.0),
    (-1.0, 2.0),
    (0.0, 2.0),
    (0.0, 3.0),
)

# Historical ``waypoint_traj_simple`` route, kept here as an explicit,
# supervised, one-shot validation profile.  Do not silently make it the
# default: its 13 m route is materially larger than the compact S test.
LEGACY_90_PATH_OFFSETS = (
    (0.0, 0.0),
    (0.0, 2.0),
    (-2.0, 2.0),
    (-2.0, 4.5),
    (0.0, 4.5),
    (0.0, 2.0),
    (0.0, 0.0),
)

# Backward-compatible names for the original compact profile and its tests.
LOCAL_PATH_OFFSETS = S_CURVE_PATH_OFFSETS
ABSOLUTE_HARD_TIMEOUT_S = 18.0
ABSOLUTE_MAX_SPEED_M_S = 0.12

# Most short validation profiles retain the original 120 ms missing-delivery
# watchdog. The mirrored route has two exact, evidence-bounded exceptions:
# 450 ms at 0.15 m/s covers the observed accepted-delivery gaps, while 200 ms
# at 0.20 m/s covers the 145 ms maximum raw receipt gap in the completed run.
# This does not relax the independent source-stamp ordering check below.
# Absolute source age is not a valid freshness signal because Vicon stamps
# originate on an unsynchronized remote clock. Nominal travel inside either
# exception (67.5 mm or 40 mm) remains below the controller's independent
# 80 mm position-jump guard, and a severe 667 ms receipt outage still aborts.
DEFAULT_STALE_ODOM_S = 0.12
MIRRORED_90_DIAGNOSTIC_SPEED_M_S = 0.15
MIRRORED_90_STALE_ODOM_S = 0.45
