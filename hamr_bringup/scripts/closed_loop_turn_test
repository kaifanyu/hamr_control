MIRRORED_90_FULL_SPEED_STALE_ODOM_S = 0.20
MAX_CONTROLLER_ODOM_TIMEOUT_S = MIRRORED_90_STALE_ODOM_S
# A safety-triggered publication stop must expire the controller's cached
# moving reference promptly.  Keep this just above the supervisor's 100 ms
# late-publication cutoff so an allowed scheduler gap cannot stop and then
# restart the controller, while a rejected cycle reaches zero within 120 ms of
# its last published reference.
REQUIRED_CONTROLLER_REFERENCE_TIMEOUT_S = 0.12
# Match the firmware's 28 RPM pair ceiling, below the measured 32.34 RPM motor
# maximum. Firmware feedforward is independently bounded at 3500 PWM so the PI
# loop retains 595 PWM of correction authority before the final output clamp.
# The controller must pair-scale both wheel targets before publishing.
HARDWARE_WHEEL_SPEED_LIMIT_RAD_S = 2.93215314335

