#!/usr/bin/env python3
"""Record ESP32 caster Wi-Fi telemetry as ROS 2 topics with honest timestamps."""

import json
import math
import sys
import time

import rclpy
from rcl_interfaces.msg import ParameterDescriptor, ParameterType
from rclpy.node import Node
from rclpy.qos import DurabilityPolicy, HistoryPolicy, QoSProfile, ReliabilityPolicy
from sensor_msgs.msg import JointState
from std_msgs.msg import String

from caster_encoder_protocol import ROLES, WHEELS, TelemetryState, UDPReceiver


class CasterEncoderBridge(Node):
    def __init__(self):
        super().__init__("caster_encoder_bridge")
        if self.get_parameter("use_sim_time").value:
            raise RuntimeError("caster_encoder_bridge requires use_sim_time=false for live receipt timestamps")
        fixed_description = "Restart the bridge to apply configuration changes."
        self.set_descriptor("use_sim_time", ParameterDescriptor(
            type=ParameterType.PARAMETER_BOOL, read_only=True, description=fixed_description))
        for name, default in (
            ("wheel_id", "front_left"), ("legacy_mode", False),
            ("require_config", False), ("configured_wheel_id", ""),
            ("expected_device_ids", ["", "", ""]),
            ("expected_source_ips", ["", "", ""]),
            ("bind_address", "0.0.0.0"), ("udp_port", 5005),
            ("stale_timeout_s", 1.0), ("expected_node_ids", [1, 2, 3]),
        ):
            self.declare_parameter(name, default, descriptor=ParameterDescriptor(
                read_only=True, description=fixed_description))
        bind_address = self.get_parameter("bind_address").value
        udp_port = self.get_parameter("udp_port").value
        stale_timeout = self.get_parameter("stale_timeout_s").value
        if type(udp_port) is not int or not 1 <= udp_port <= 65535:
            raise RuntimeError("udp_port must be an integer in 1..65535")
        if not math.isfinite(stale_timeout) or stale_timeout <= 0:
            raise RuntimeError("stale_timeout_s must be finite and positive")
        wheel_id = self.get_parameter("wheel_id").value
        legacy_mode = self.get_parameter("legacy_mode").value
        if type(legacy_mode) is not bool:
            raise ValueError("legacy_mode must be a boolean")
        if legacy_mode:
            if wheel_id:
                raise ValueError("legacy_mode requires an empty wheel_id")
            wheel_id = None
        elif wheel_id not in WHEELS:
            raise ValueError("wheel_id must be front_left or front_right")
        if self.get_parameter("require_config").value:
            configured_wheel = self.get_parameter("configured_wheel_id").value
            if configured_wheel != wheel_id:
                raise ValueError(
                    f"Missing or mismatched caster configuration: configured_wheel_id={configured_wheel!r}, "
                    f"expected {wheel_id!r}. Check the node key in caster_encoders.yaml; "
                    "dual launch requires /caster_encoder_front_left and /caster_encoder_front_right."
                )
        self.topic_prefix = "/caster_encoder" + ("/" + wheel_id if wheel_id else "")
        self.state = TelemetryState(
            self.get_parameter("expected_node_ids").value, stale_timeout,
            wheel_id=wheel_id, allow_legacy=legacy_mode,
            expected_device_ids=self.get_parameter("expected_device_ids").value,
            expected_source_ips=self.get_parameter("expected_source_ips").value)
        qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST, depth=1000,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.VOLATILE,
        )
        metadata_qos = QoSProfile(
            history=HistoryPolicy.KEEP_LAST, depth=1,
            reliability=ReliabilityPolicy.RELIABLE,
            durability=DurabilityPolicy.TRANSIENT_LOCAL,
        )
        self.packets = self.create_publisher(String, f"{self.topic_prefix}/packets", qos)
        self.diagnostics = self.create_publisher(String, f"{self.topic_prefix}/diagnostics", qos)
        self.metadata = self.create_publisher(String, f"{self.topic_prefix}/metadata", metadata_qos)
        self.joints = {
            node: self.create_publisher(JointState, f"{self.topic_prefix}/{role}/joint_states", qos)
            for node, role in ROLES.items()
        }
        self.receiver = UDPReceiver(bind_address, udp_port)
        self.last_warning = -math.inf
        self.last_invalid_warning = -math.inf
        self.create_timer(0.002, self.receive)
        self.create_timer(1.0, self.publish_diagnostics)
        self.metadata.publish(self.json_message(self.state.metadata_snapshot()))
        self.get_logger().info(
            f"Listening on UDP {bind_address}:{udp_port}; ESP acquisition clocks are unsynchronized. "
            f"ROS headers use host receipt time; original samples and clocks are in {self.topic_prefix}/packets."
        )
        if not legacy_mode and not all(self.state.expected_device_ids):
            self.get_logger().warning(
                f"{wheel_id}: device inventory is incomplete; commissioning mode pins the first "
                "device observed per role until restart. Set expected_device_ids in caster_encoders.yaml "
                "after checking physical board labels; inventory_verified remains false."
            )

    @staticmethod
    def json_message(value):
        message = String()
        message.data = json.dumps(value, separators=(",", ":"), allow_nan=False)
        return message

    def receive(self):
        # Reject a runtime switch as well as startup use_sim_time=true. Never
        # silently stamp physical acquisitions against bag playback time.
        if self.get_parameter("use_sim_time").value:
            raise RuntimeError("Live encoder bridge cannot run with use_sim_time=true")
        for data, source, epoch_ns, monotonic_ns in self.receiver.drain():
            stamp = self.get_clock().now()
            try:
                envelope, readings, metadata_changed = self.state.receive(
                    data, source, epoch_ns, monotonic_ns, stamp.nanoseconds)
            except ValueError as error:
                now = time.monotonic()
                if now - self.last_invalid_warning >= 5.0:
                    self.get_logger().warning(f"Rejected caster encoder datagram: {error}")
                    self.last_invalid_warning = now
                continue
            self.packets.publish(self.json_message(envelope))
            if metadata_changed:
                self.metadata.publish(self.json_message(self.state.metadata_snapshot()))
            for reading in readings:
                message = JointState()
                message.header.stamp = stamp.to_msg()
                message.name = [reading["name"]]
                message.position = [float(reading["position"])]
                if reading["velocity"] is not None:
                    message.velocity = [float(reading["velocity"])]
                self.joints[reading["node_id"]].publish(message)

    def publish_diagnostics(self):
        report = self.state.diagnostics_snapshot(time.monotonic_ns())
        report["receive_ros_ns"] = self.get_clock().now().nanoseconds
        self.diagnostics.publish(self.json_message(report))
        stale = [node["role"] for node in report["nodes"] if node["expected"] and node["stale"]]
        now = time.monotonic()
        if stale and now - self.last_warning >= 5.0:
            self.get_logger().warning(
                "No recent encoder samples from: " + ", ".join(stale) +
                ". Check ESP receiver IPv4, 2.4 GHz Wi-Fi, UDP port, and node power."
            )
            self.last_warning = now

    def destroy_node(self):
        if hasattr(self, "receiver"):
            self.receiver.close()
        return super().destroy_node()


def main(args=None):
    rclpy.init(args=args)
    node = None
    try:
        node = CasterEncoderBridge()
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    except (RuntimeError, ValueError, OSError) as error:
        print(f"caster_encoder_bridge: {error}", file=sys.stderr)
        return 2
    finally:
        if node is not None:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
