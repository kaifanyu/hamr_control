#!/usr/bin/env bash
set -euo pipefail

BAG_ROOT="${HAMR_BAG_ROOT:-/home/hamr/hamr_ws/src/hamr_holonomic_robot/rosbags}"
RUN_NAME="${HAMR_BAG_NAME:-hamr_hw_$(date +%Y%m%d_%H%M%S)}"
STORAGE_ID="${HAMR_BAG_STORAGE_ID:-mcap}"
BAG_DIR="${BAG_ROOT}/${RUN_NAME}"

CONFIG_DIR="$(ros2 pkg prefix hamr_bringup)/share/hamr_bringup/config"
TOPIC_REGEX="$(cat "${CONFIG_DIR}/recording_topics.regex")"

mkdir -p "${BAG_ROOT}"

echo "Recording HAMR Vicon bag:"
echo "  output:  ${BAG_DIR}"
echo "  storage: ${STORAGE_ID}"
echo "  regex:   ${TOPIC_REGEX}"

exec ros2 bag record \
  --storage "${STORAGE_ID}" \
  --output "${BAG_DIR}" \
  --disable-keyboard-controls \
  --qos-profile-overrides-path "${CONFIG_DIR}/recording_qos.yaml" \
  --regex "${TOPIC_REGEX}"
