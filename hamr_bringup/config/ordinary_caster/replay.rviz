Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Fixed Frame: ordinary_caster_history
    Background Color: 35; 39; 45
  Displays:
    - Class: rviz_default_plugins/Marker
      Name: Acquisition validity
      Enabled: true
      Marker Topic:
        Value: /ordinary_caster/replay/status_marker
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 10
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane: XY
    - Class: rviz_default_plugins/RobotModel
      Name: Recorded ordinary caster orientation
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        Depth: 1
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.3
      Focal Point:
        X: 0
        Y: 0
        Z: -0.1
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Width: 1200
  Height: 800
