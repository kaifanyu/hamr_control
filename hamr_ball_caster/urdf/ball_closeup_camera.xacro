<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="ball_closeup_camera" params="parent">
    <!-- Same external side camera as the ordinary-caster comparison. The sensor
         follows the rocker, never a freely rotating ball component. -->
    <link name="ball_closeup_camera_link">
      <inertial><mass value="0.001"/><inertia ixx="0.000001" iyy="0.000001" izz="0.000001" ixy="0" ixz="0" iyz="0"/></inertial>
    </link>
    <joint name="ball_closeup_camera_joint" type="fixed">
      <parent link="${parent}"/><child link="ball_closeup_camera_link"/>
      <origin xyz="0.185 -0.55 0.01" rpy="0 0.312 1.3506"/>
    </joint>
    <gazebo reference="ball_closeup_camera_link">
      <sensor name="ball_caster_closeup" type="camera">
        <always_on>true</always_on><update_rate>25</update_rate><visualize>false</visualize>
        <topic>/hamr/ball_caster/closeup/image</topic>
        <camera><horizontal_fov>1.0</horizontal_fov><image><width>1280</width><height>720</height><format>R8G8B8</format></image><clip><near>0.02</near><far>100</far></clip></camera>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
