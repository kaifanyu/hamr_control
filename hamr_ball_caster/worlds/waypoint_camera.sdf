<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <model name="waypoint_recording_camera">
    <static>true</static>
    <pose>5.0 -4.0 8.0 0 0.745580810982 2.335789159506</pose>
    <link name="camera_link">
      <sensor name="overview" type="camera">
        <always_on>true</always_on>
        <update_rate>25</update_rate>
        <topic>/hamr/recording_camera/image</topic>
        <camera>
          <horizontal_fov>0.9</horizontal_fov>
          <image>
            <width>1280</width>
            <height>720</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.1</near>
            <far>100</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>