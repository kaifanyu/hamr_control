<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:property name="camera_length" value="0.01" />
    <xacro:property name="camera_width" value="0.1" />
    <xacro:property name="camera_height" value="0.05" />

    <link name="camera_link">
        <visual>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
            <origin xyz="${camera_length / 2.0} 0 0" rpy="0 0 0" />
            <material name="black" />
        </visual>
        <collision>
            <geometry>
                <box size="${camera_length} ${camera_width} ${camera_height}" />
            </geometry>
        </collision>
        <xacro:box_inertia m="0.1" x="${camera_length}" y="${camera_width}" z="${camera_height}"
                        o_xyz="${camera_length / 2.0} 0 0" o_rpy="0 0 0" />
    </link>

    <link name="camera_link_optical">
    </link>

    <joint name="turret_camera_joint" type="fixed">
        <parent link="turret_link" />
        <child link="camera_link" />
        <!-- pitched 20 deg down so visual odometry always sees nearby
             depth-valid terrain instead of horizon/sky (level mounting
             starves VO of 3D features on open ground) -->
        <origin xyz="0 0 0.1" rpy="0 ${20.0 * pi / 180.0} ${-pi / 2.0}"/>
    </joint>
    
    <!-- generate an optical frame 
    http://www.ros.org/reps/rep-0103.html#suffix-frames
    so that ros and opencv can operate on the camera frame correctly 
    -->
    <joint name="camera_optical_joint" type="fixed">
        <!-- these values have to be these values otherwise the gazebo camera
            image won't be aligned properly with the frame it is supposedly
            originating from -->
        <parent link="camera_link"/>
        <child link="camera_link_optical"/>
        <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}"/>
    </joint>

    <!-- RGB-D camera - publishes camera/image, camera/depth_image,
        camera/points and camera/camera_info on the gz side.
        Depth is required for dense VSLAM mapping (RTAB-Map).
        NOTE - no "colon+space" allowed in comments here, the launch
        $(command 'xacro ...') output is parsed as YAML. -->
    <gazebo reference="camera_link">
        <sensor name="camera" type="rgbd_camera">
            <camera>
                <!-- 100 deg - wide FOV keeps features in view through the
                     base's fast yaw swings (visual odometry robustness) -->
                <horizontal_fov>1.7453293</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.1</near>
                    <far>15</far>
                </clip>
                <depth_camera>
                    <clip>
                        <near>0.1</near>
                        <far>15</far>
                    </clip>
                </depth_camera>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.007</stddev>
                </noise>
                <optical_frame_id>camera_link_optical</optical_frame_id>
                <camera_info_topic>camera/camera_info</camera_info_topic>
            </camera>
            <always_on>1</always_on>
            <update_rate>20</update_rate>
            <visualize>true</visualize>
            <topic>camera</topic>
        </sensor>
    </gazebo>

</robot>